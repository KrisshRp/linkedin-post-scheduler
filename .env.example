# Copy to .env and fill in. Real environment variables override this file. NEVER commit .env.
# Full setup walkthrough: README.md and .context/04-dependencies.md

# ===== App =====
APP_BASE_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DB_PATH=data/app.db

# ===== LinkedIn app =====
# 1. https://www.linkedin.com/developers/apps -> Create app (needs a LinkedIn Company Page; a throwaway page is fine).
# 2. Products tab: add "Sign In with LinkedIn using OpenID Connect" AND "Share on LinkedIn" (both self-serve).
# 3. Auth tab: copy Client ID + Primary Client Secret below.
# 4. Auth tab -> Authorized redirect URLs: add exactly the LINKEDIN_REDIRECT_URI value below.
# Not needed when PUBLISH_MODE=dry_run.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback
# openid+profile+email = login identity, w_member_social = permission to post
LINKEDIN_SCOPES=openid profile email w_member_social
# Header "Linkedin-Version" for POST /rest/posts, format YYYYMM. LinkedIn retires versions after ~12 months:
# "426 ... version is not active" means this value is too old, set a recent month.
LINKEDIN_API_VERSION=202610

# ===== Security (REQUIRED; generate once, keep secret) =====
# Encrypts LinkedIn tokens in the database. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/changing this key makes stored tokens unreadable (users just log in again).
TOKEN_ENCRYPTION_KEY=
# Signs the login session cookie. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Set true when served over https
COOKIE_SECURE=false

# ===== Worker / retry =====
WORKER_POLL_SECONDS=5
# Attempts per post before it is marked failed
MAX_ATTEMPTS=5
# Delay after attempt n = RETRY_BASE_SECONDS * 5^(n-1), capped at RETRY_MAX_SECONDS, plus up to 20% jitter
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=7200

# ===== Publishing mode =====
# live    = really post to LinkedIn
# dry_run = fake publisher, nothing leaves your machine; enables /auth/dev-login (demo + offline testing)
PUBLISH_MODE=live
# dry_run only: fail the first N attempts of every post with a fake 503 to demo retries and backoff
FAULT_INJECT=0
